{
  "name": "maxia",
  "version": "0.1.0",
  "private": true,
  "description": "MAX — assistente local de IA por voz para desktop",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --experimental-strip-types apps/desktop/src/main/modules/*.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:dir": "npm run build && electron-builder --mac --dir",
    "native:speech": "npm run native:helpers",
    "predev": "npm run native:helpers",
    "prebuild": "npm run native:helpers",
    "native:helpers": "node scripts/build-native-speech.mjs"
  },
  "dependencies": {
    "default-browser": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.27.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.maxease.maxia",
    "productName": "MAX",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "A MAX usa o microfone para ouvir o wake word e comandos de voz.",
        "NSCameraUsageDescription": "A MAX usa a câmera somente quando Henrique autoriza.",
        "NSSpeechRecognitionUsageDescription": "A MAX processa voz localmente para reconhecer comandos."
      }
    },
    "extraResources": [
      {
        "from": "build/native/speech-helper",
        "to": "native/speech-helper"
      },
      {
        "from": "build/native/language-helper",
        "to": "native/language-helper"
      }
    ]
  }
}
